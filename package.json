{
  "name": "gl-reconciliation",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "private": true,
  "dependencies": {
    "@cap-js/hana": "^2",
    "@cap-js/postgres": "^2.2.0",
    "@sap-cloud-sdk/connectivity": "^3",
    "@sap-cloud-sdk/http-client": "^3",
    "@sap-cloud-sdk/resilience": "^3",
    "@sap/cds": "^9",
    "express": "^4",
    "global-agent": "^4.1.3",
    "http-proxy-agent": "^9.0.0",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9"
  },
  "scripts": {
    "start": "cds-serve",
    "test": "node --test 'srv/services/__tests__/*.test.js' 'srv/__tests__/*.test.js'",
    "test:integration": "node integration-test.js",
    "find-high-volume": "node find-high-volume.js"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "postgres",
        "schema_evolution": "off"
      },
      "auth": {
        "kind": "dummy"
      },
      "DATASPHERE": {
        "kind": "rest",
        "credentials": {
          "destination": "DATASPHERE_TEST",
          "requestTimeout": 30000
        }
      },
      "SAP_S4_ODATA": {
        "kind": "rest",
        "credentials": {
          "destination": "SAP_S4_ODATA",
          "requestTimeout": 30000
        }
      }
    }
  }
}
